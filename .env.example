SCENTIQ_ENV=development
POSTGRES_DB=scentiq_local
POSTGRES_USER=scentiq_local
POSTGRES_PASSWORD=scentiq_local_only
DATABASE_URL=postgresql+psycopg://scentiq_local:scentiq_local_only@db:5432/scentiq_local
CORS_ORIGINS=http://localhost:3000
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_APP_ENV=development
AZURE_CLIENT_ID=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_KEY_VAULT_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Identity (Clerk) ---------------------------------------------------
# Placeholders only. Real values live in Key Vault-backed Container App
# secrets and must never be committed.
# The browser talks only to Next.js, so only the publishable key is public.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Verifies the signed user.deleted webhook in the Next.js route.
CLERK_WEBHOOK_SECRET=

# FastAPI token verification. Authentication fails closed until CLERK_ISSUER
# is set. The ScentIQ Clerk JWT template must include an `email` claim, which
# is the only source just-in-time provisioning has for a new user's email.
CLERK_ISSUER=
# Optional; defaults to <CLERK_ISSUER>/.well-known/jwks.json
CLERK_JWKS_URL=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=

# Shared secret for the internal identity-event endpoint, used only by the
# Next.js webhook route. Not a user credential.
INTERNAL_SERVICE_TOKEN=
